{
  "name": "ai-workspace-knowledge",
  "private": true,
  "description": "Herramientas de desarrollo del repositorio de conocimiento AI-Workspace",
  "scripts": {
    "openspec": "openspec",
    "openspec:check": "openspec validate --all --strict --no-interactive",
    "test:openspec": "node --test tests/test_openspec.mjs",
    "codegraph": "node scripts/codegraph.mjs",
    "test:codegraph": "node --test tests/test_codegraph.mjs",
    "uml:render": "python scripts/uml.py render --manifest software-office/templates/uml/diagrams.example.json",
    "uml:check": "python scripts/uml.py check --manifest software-office/templates/uml/diagrams.example.json",
    "test:uml": "python -m unittest discover -s tests -p test_uml.py"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@fission-ai/openspec": "1.14.3",
    "@mermaid-js/mermaid-cli": "12.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
